from perlin_noise import PerlinNoise
import numpy as np
import matplotlib.pyplot as plt

w, h = 512, 512
base_scale = 100
noise = PerlinNoise(octaves=6)

def gen_chunk(offset_x=0, offset_y=0, zoom=1.0):
    world = np.zeros((h, w))
    scale = base_scale / zoom
    for y in range(h):
        for x in range(w):
            nx = (x + offset_x) / scale
            ny = (y + offset_y) / scale
            world[y][x] = noise([nx, ny])
    return world

def get_color(v):
    if v < -0.05: return (0, 0, 0.5)
    elif v < 0: return (0, 0, 0.8)
    elif v < 0.05: return (0.9, 0.85, 0.5)
    elif v < 0.3: return (0, 0.6, 0.1)
    elif v < 0.6: return (0.2, 0.4, 0.1)
    elif v < 0.8: return (0.5, 0.3, 0.1)
    else: return (1, 1, 1)

def render(world):
    img = np.zeros((h, w, 3))
    for y in range(h):
        for x in range(w):
            img[y][x] = get_color(world[y][x])
    plt.imshow(img)
    plt.axis('off')
    plt.show()

# Try zooming and panning:
world = gen_chunk(offset_x=0, offset_y=0, zoom=1)
render(world)

world = gen_chunk(offset_x=500, offset_y=1000, zoom=1)
render(world)

world = gen_chunk(offset_x=1000, offset_y=2000, zoom=4)
render(world)
